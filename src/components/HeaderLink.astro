---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const { pathname } = Astro.url;

// Resolver el path completo anteponiendo la base si es una ruta relativa/interna
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefString = typeof href === 'string' ? href : String(href);
const resolvedHref = hrefString.startsWith('/') ? `${base}${hrefString}` : hrefString;

const subpath = pathname.replace(base, '').match(/[^\/]+/g);
const isActive = hrefString === pathname || hrefString === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>